# === Database ===
POSTGRES_USER=deploy_panel
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=deploy_panel
DATABASE_URL="postgresql://deploy_panel:CHANGE_ME_STRONG_PASSWORD@localhost:5432/deploy_panel"

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL="redis://localhost:6379"

# === JWT Secrets (generate with: openssl rand -hex 32) ===
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"

# === Encryption Key for SSH keys/tokens (generate with: openssl rand -hex 32) ===
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# === Server ===
PORT=3001
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

# === Backups ===
BACKUP_DIR=./backups

# === Telegram Notifications (optional) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
